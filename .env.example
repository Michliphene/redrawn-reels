# Copy to .env (scripts/setup-local.sh does it). Never commit .env.
# ElevenLabs key (voice "Brian"). In the cloud the proxy injects it; locally it must be here.
ELEVENLABS_API_KEY=
# WebGL back-end for the DA 2 3D world. Default: angle on macOS/Windows, swangle (software) on Linux.
# With a GPU on Linux: angle-egl (much faster). Leave empty for the default.
# REMOTION_GL=angle
# Use your own Chrome/Chromium instead of the one Remotion downloads (optional).
# REMOTION_CHROME=
