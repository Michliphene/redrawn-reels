{
  "name": "studio-reels",
  "version": "1.0.0",
  "description": "Short-form video studio: one cue language, several series (REDRAWN maps, RECEIPTS money), shared art direction kit.",
  "scripts": {
    "check": "tsc --noEmit -p . && node scripts/validate.mjs --all",
    "test": "npm run check && tsx --test tests/*.test.ts",
    "validate": "node scripts/validate.mjs",
    "stills": "node scripts/stills.mjs",
    "render": "pipeline/render.sh",
    "studio": "remotion studio src/index.ts",
    "direct": "node scripts/direct.mjs",
    "preview": "node scripts/preview.mjs",
    "test:unit": "tsx --test tests/*.test.ts",
    "test:posting": "python -m unittest discover -s tests -p test_posting_kit.py"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.79.0",
    "@react-three/fiber": "^8.17.10",
    "@remotion/cli": "^4.0.542",
    "@remotion/google-fonts": "^4.0.542",
    "@remotion/lottie": "^4.0.542",
    "@remotion/media-utils": "^4.0.542",
    "@remotion/noise": "4.0.542",
    "@remotion/paths": "4.0.542",
    "@remotion/shapes": "4.0.542",
    "@remotion/three": "4.0.542",
    "@turf/turf": "^7.4.0",
    "d3-geo": "^3.1.2",
    "flag-icons": "^7.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.542",
    "three": "^0.170.0",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^19.3.0",
    "@types/three": "^0.170.0",
    "@types/topojson-client": "^3.1.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true
}
